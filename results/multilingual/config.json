{
  "seed": 0,
  "model": {
    "id": "CohereLabs/tiny-aya-global",
    "trust_remote_code": false
  },
  "data": {
    "harmful_probe_source": {
      "name": "walledai/AdvBench",
      "split": "train",
      "column": "prompt"
    },
    "eval_source": {
      "name": "walledai/HarmBench",
      "config": "standard",
      "split": "train",
      "column": "prompt"
    },
    "harmless_source": {
      "name": "tatsu-lab/alpaca",
      "split": "train"
    },
    "harmful_train_source": {
      "name": "LLM-LAT/harmful-dataset",
      "split": "train"
    },
    "n_cal": 64,
    "n_probe": 64,
    "n_eval": 64,
    "n_train": 512,
    "n_control_refusals": 64,
    "aya_redteam_source": {
      "name": "CohereForAI/aya_redteaming"
    },
    "aya_harmless_source": {
      "name": "CohereForAI/aya_dataset",
      "split": "train"
    },
    "languages": {
      "hi": {
        "redteam_file": "aya_hin.jsonl",
        "aya_dataset_languages": [
          "Hindi",
          "hin"
        ]
      },
      "tl": {
        "redteam_file": "aya_tgl.jsonl",
        "aya_dataset_languages": [
          "Filipino",
          "Tagalog",
          "tgl",
          "fil"
        ]
      }
    },
    "ml_n_cal": 32,
    "ml_n_probe": 32,
    "ml_n_eval": 48
  },
  "probe": {
    "batch_size": 8,
    "layer_range": [
      0.2,
      0.8
    ],
    "n_tokens": 10,
    "bootstrap": 200,
    "every": 4
  },
  "eval": {
    "steps": [
      0,
      8,
      16,
      32,
      64,
      128
    ],
    "max_new_tokens": 96,
    "batch_size": 16
  },
  "judge": {
    "kind": "auto",
    "model_id": "allenai/wildguard",
    "device": "cuda:1",
    "quant": "4bit",
    "batch_size": 8
  },
  "train": {
    "max_steps": 128,
    "lr": 0.0001,
    "warmup_steps": 4,
    "micro_batch": 2,
    "grad_accum": 4,
    "max_len": 1024,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "grad_ckpt": true
  },
  "conditions": [
    "pos",
    "control"
  ],
  "analysis": {
    "signal": "S3",
    "z_threshold": -3.0,
    "persistence": 2,
    "cusum_k": 0.5,
    "cusum_h": 5.0,
    "asr_jump": 0.1,
    "go": {
      "min_pos_asr_gain": 0.3,
      "max_control_asr_gain": 0.1,
      "min_abs_spearman": 0.7
    }
  }
}